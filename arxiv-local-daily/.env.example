# Copy this file to .env and paste the token from Cloudflare Zero Trust.
# Keep .env private. Do not commit real tokens.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Debian apt mirrors used while building the app image.
# Defaults use TUNA. Aliyun ECS can try:
# DEBIAN_MIRROR=http://mirrors.cloud.aliyuncs.com/debian
# DEBIAN_SECURITY_MIRROR=http://mirrors.cloud.aliyuncs.com/debian-security
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
